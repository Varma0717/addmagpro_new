# ============================================
# AddMagPro Production Environment Configuration
# ============================================
# 
# This is a template for production .env file
# Copy this as .env and update with actual production values
# NEVER commit .env to git repository
#
# ============================================

APP_NAME=AddMagPro
APP_ENV=production
APP_KEY=base64:SET_THIS_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ============================================
# Database Configuration
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=admagpro_production
DB_USERNAME=admagpro_user
DB_PASSWORD=VERY_SECURE_PASSWORD_HERE
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ============================================
# Cache & Session Configuration
# ============================================
CACHE_DRIVER=redis
CACHE_REDIS_HOST=127.0.0.1
CACHE_REDIS_PASSWORD=null
CACHE_REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=10080

QUEUE_CONNECTION=redis

# ============================================
# Mail Configuration (for notifications)
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=AddMagPro

# ============================================
# Authentication
# ============================================
AUTH_DRIVER=sanctum
SANCTUM_STATEFUL_DOMAINS=yourdomain.com
SESSION_DOMAIN=yourdomain.com

# ============================================
# Razorpay Payment Gateway (LIVE KEYS)
# ============================================
RAZORPAY_MODE=live
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_LIVE_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# ============================================
# Google Maps API (Optional)
# ============================================
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY

# ============================================
# AWS S3 Configuration (for file storage)
# ============================================
AWS_ACCESS_KEY_ID=YOUR_AWS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=admagpro-uploads
AWS_URL=https://s3.amazonaws.com/admagpro-uploads
AWS_VISIBILITY=public

# ============================================
# Application Configuration
# ============================================
LOG_CHANNEL=stack
LOG_LEVEL=error

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_DURATION=60

# Wallet configuration
WALLET_MINIMUM_TOPUP=100
WALLET_MAXIMUM_TOPUP=100000
WALLET_REFERRAL_BONUS=100
WALLET_TOPUP_FEE_PERCENTAGE=0

# Search configuration
SEARCH_FULL_TEXT_ENABLED=true
SEARCH_VOICE_ENABLED=true
SEARCH_BARCODE_ENABLED=true

# ============================================
# Security
# ============================================
BCRYPT_ROUNDS=12
JWT_ALGORITHM=HS256
CSRF_TRUSTED_HOSTS=yourdomain.com

# ============================================
# Monitoring & Analytics
# ============================================
SENTRY_LARAVEL_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================
# Third-party Services
# ============================================
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_PRIVATE_KEY=your-firebase-key
FIREBASE_CLIENT_EMAIL=firebase@yourdomain.iam.gserviceaccount.com

# ============================================
# Admin Settings
# ============================================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

# ============================================
# Feature Flags
# ============================================
FEATURE_REFERRAL_PROGRAM=true
FEATURE_VOICE_SEARCH=true
FEATURE_BARCODE_SCANNING=true
FEATURE_WALLET_TRANSFER=true
FEATURE_PRODUCT_REVIEWS=true
FEATURE_WISHLISTS=true

# ============================================
# Performance Tuning
# ============================================
QUERY_LOG_ENABLED=false
SLOW_QUERY_THRESHOLD=1000

# ============================================
# Backup Configuration
# ============================================
BACKUP_DISK=s3
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# ============================================
# SSL/TLS
# ============================================
FORCE_HTTPS=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
